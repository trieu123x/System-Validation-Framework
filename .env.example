# Copy thành .env (không đưa lên git) để đổi cấu hình docker compose.
# Mật khẩu PostgreSQL trong container (chỉ có hiệu lực lần đầu tạo volume pgdata)
DB_PASSWORD=phanphoi
# 1 = nạp dữ liệu demo lớn (db/seed_demo.sql) khi tạo CSDL lần đầu
SEED_DEMO=1
# Mật khẩu trang công ty: hex SHA-256("pp-admin-2026" + mật khẩu); để trống = admin123
ADMIN_PASSWORD_HASH=
# Cổng trên máy host
SERVER_TCP_PORT=5000
ADMIN_HTTP_PORT=8080
CN01_HTTP_PORT=8081
CN02_HTTP_PORT=8082
DB_HOST_PORT=5433

# Email backend (khong dat vao landing/.env.local; khong dung tien to VITE_).
# Ban giao, chon Mailpit/Gmail va phan biet email voi dang nhap: docs/EMAIL.md.
# De false neu chua co SMTP. Thu local bang docker-compose.mailpit.yml.
# true neu da dien mat khau mail o ben duoi
MAIL_ENABLED=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=noreply@phanphoi.test
# Nhieu quan tri vien ngan cach bang dau phay; moi chi nhanh mot email.
MAIL_ADMIN_RECIPIENTS=
MAIL_BRANCH_RECIPIENTS=
# Vi du: MAIL_BRANCH_RECIPIENTS=CN01=cn01@example.test;CN02=cn02@example.test

# New anti-scraping policy: detect first, then block after staging checks.
SCRAPING_MODE=detect
