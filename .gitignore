# ================================================================
# System Validation Framework - Git ignore
# Keep source code, SQL migrations, docs and validation evidence.
# ================================================================

# Secrets and local environment configuration
.env
.env.*
!.env.example
!**/.env.example
config/*.local.properties
*.pem
*.p12
*.pfx
*.key
*.jks
*.keystore
id_rsa
id_ed25519

# Java / Maven build output
target/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# Node.js / Next.js / Vite build output
node_modules/
.next/
out/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
ui/next-env.d.ts

# Python generated files, if scripts are used
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Logs, temporary output, and local caches
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/loadsim-result.csv
/experiments-run.log
/experiments/results/logs/
scripts/images/cache/
*.tmp
*.temp
*.swp
*.swo
*~

# OS and IDE local files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vs/
*.iml
.vscode/*.local.json

# Assistant-specific local files (keep shared agent config)
CLAUDE.local.md
.claude/settings.local.json
