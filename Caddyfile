# Local HTTP-only Caddy reverse proxies. Public TLS is handled by Tailscale Funnel.
:9000 {
    @blocked path /api/experiment /api/experiment/*
    respond @blocked 404
    reverse_proxy 127.0.0.1:8080 {
        header_up Host localhost:8080
    }
}

:9001 {
    reverse_proxy 127.0.0.1:8081 {
        header_up Host localhost:8081
    }
}

:9002 {
    reverse_proxy 127.0.0.1:8082 {
        header_up Host localhost:8082
    }
}
